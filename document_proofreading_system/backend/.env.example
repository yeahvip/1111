ELASTICSEARCH_HOSTS='["http://localhost:9200"]' # For a single host as a JSON string list
# ELASTICSEARCH_HOSTS="http://localhost:9200" # Alternatively, as a single URL or comma-separated for parsing
# ELASTICSEARCH_USER=your_es_user
# ELASTICSEARCH_PASSWORD=your_es_password
